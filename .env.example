# ==============================================================================
# IronTracker Infrastructure Environment Configuration
# ==============================================================================

# PostgreSQL (Workout Service)
POSTGRES_USER=irontracker
POSTGRES_PASSWORD=irontracker_secret
POSTGRES_DB=irontracker_workout
POSTGRES_PORT=5432
# Connection string: postgresql+asyncpg://irontracker:irontracker_secret@localhost:5432/irontracker_workout

# Redis (Leaderboard Service)
REDIS_PORT=6379
# Connection string: redis://localhost:6379/0

# MongoDB (Analytics Service)
MONGO_USER=irontracker
MONGO_PASSWORD=irontracker_mongo_secret
MONGO_DB=irontracker_analytics
MONGO_PORT=27017
# Connection string: mongodb://irontracker:irontracker_mongo_secret@localhost:27017/irontracker_analytics?authSource=admin

# Apache Kafka (Event Bus / KRaft Mode)
KAFKA_EXTERNAL_PORT=9092
# Host bootstrap server: localhost:9092
# Docker network bootstrap server: kafka:29092

# RabbitMQ (Command Queues & Notification Service)
RABBITMQ_USER=irontracker
RABBITMQ_PASSWORD=irontracker_rabbit_secret
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672
# AMQP URI: amqp://irontracker:irontracker_rabbit_secret@localhost:5672/
# Management UI: http://localhost:15672

# Kafka UI (Optional Web Interface: docker compose --profile tools up -d)
KAFKA_UI_PORT=8085
# Web UI: http://localhost:8085
